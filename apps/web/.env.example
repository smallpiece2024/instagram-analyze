# Web アプリ用の環境変数。このファイルを apps/web/.env.local にコピーして値を入れる（.env.local は Git 管理外）。
# Next.js は apps/web/ 直下の .env* しか読まない（ルートの .env はワーカー用で、Web には渡らない）。
# NEXT_PUBLIC_ が付く変数だけがブラウザに送られる。それ以外はサーバー側だけで読む（src/lib/env.ts の readEnv）。
# 書式の不備は変数名だけを示して画面に出る（値は出ない）。

# ---------------------------------------------------------------------------
# ブラウザに渡してよい値（R0 の接続確認に使う）
# ---------------------------------------------------------------------------
# Supabase の API の URL（ローカルは http://127.0.0.1:54321）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase の publishable key。値は `npm run db:status`（ルートで実行）の出力から取る
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# サーバー側だけ（秘密を含む。NEXT_PUBLIC_ を付けない）
# ---------------------------------------------------------------------------
# Postgres への接続文字列（画面の読み出しと、接続時の Vault への書き込みに使う。REST は使わない）。
# ローカルは Supabase CLI の DB。R2 ではプーラーのトランザクションモードの URL に差し替える。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase の URL（サーバー側。サムネイルの署名付き URL を作る）。ローカルは http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321

# サービスロールキー（秘密。サムネイルの署名付き URL を作る）。値は `npm run db:status` の service_role キー
SUPABASE_SERVICE_ROLE_KEY=

# Meta アプリの ID（数字列）とシークレット（Facebook Login と debug_token に使う。ワーカーの .env と同じ値）
META_APP_ID=
META_APP_SECRET=

# 使用する Graph API のバージョン（v<数字>.<数字> の形。省略時は v25.0）
META_GRAPH_API_VERSION=v25.0

# このアプリの URL のオリジン（パスと末尾のスラッシュを付けない）。Facebook Login の戻り先 ${APP_URL}/api/meta/callback の元
APP_URL=http://localhost:3000

# 任意。Instagram アカウントの数値 ID。指定すると候補の数にかかわらず一致するページだけを登録し、一致がなければ登録しない
META_TARGET_IG_USER_ID=

# ---------------------------------------------------------------------------
# 結合テスト（.env.local には書かず、シェルで渡す）
# ---------------------------------------------------------------------------
# 設定されているときだけ結合テストが動く。例:
#   TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres npm run test -w web
