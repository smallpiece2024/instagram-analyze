# 収集ワーカー用の環境変数（docker compose が読み込む）
# このファイルを .env にコピーして値を入れる。.env は Git 管理外。

# Meta（Facebook Login 方式）
# ユーザーアクセストークンとページアクセストークンのどちらでもよい。
# 自動収集には、長期ユーザートークンから取得した期限のないページトークンを推奨する。
# ページトークンは、Instagram アカウントを接続した Facebook ページのものを使うこと。
# 必要な権限: instagram_basic, instagram_manage_insights, pages_show_list, pages_read_engagement
META_ACCESS_TOKEN=

# 使用する Graph API のバージョン（自動で上がらないよう固定する。NF-REL-04）
META_GRAPH_API_VERSION=v25.0

# Instagram アカウントの ID（数値。例: 17841...。ユーザー名ではない）
# ユーザートークンなら空でもよい（/me/accounts から自動で探す）。ページトークンなら必須。
# 調べ方: Graph API エクスプローラで me?fields=instagram_business_account{id,username} を実行する
IG_USER_ID=

# 任意: 設定すると debug_token でトークンの種類と有効期限を調べる
META_APP_ID=
META_APP_SECRET=
