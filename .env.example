# 収集ワーカー用の環境変数（docker compose が読み込む）
# このファイルを .env にコピーして値を入れる。.env は Git 管理外。
# 書式はワーカーの起動時に検証され、不正なら変数名だけを示して止まる（値は出さない）。

# ---------------------------------------------------------------------------
# Meta アプリ（必須）
# ---------------------------------------------------------------------------
# register-token と token_check が debug_token（トークンの種類、有効期限、権限の確認）に使う。
META_APP_ID=
META_APP_SECRET=

# 使用する Graph API のバージョン（自動で上がらないよう固定する。NF-REL-04）
META_GRAPH_API_VERSION=v25.0

# ---------------------------------------------------------------------------
# トークンの登録（register-token と verify-api だけが読む）
# ---------------------------------------------------------------------------
# ユーザーアクセストークンとページアクセストークンのどちらでもよい。
# 自動収集には、長期ユーザートークンから取得した期限のないページトークンを推奨する。
# ページトークンは、Instagram アカウントを接続した Facebook ページのものを使うこと。
# 収集に必要な権限: instagram_basic, instagram_manage_insights, pages_read_engagement
# （pages_show_list は verify-api が IG_USER_ID なしで me/accounts を引くときにだけ要る。収集では使わない）
# `worker register-token` で DB（Vault）に登録したら、この値は .env から消してよい。ジョブは .env のトークンを読まない。
META_ACCESS_TOKEN=

# Instagram アカウントの ID（数値。例: 17841...。ユーザー名ではない）。register-token に必須。
# verify-api では、ユーザートークンなら空でもよい（/me/accounts から自動で探す）。ページトークンなら必須。
# 調べ方: Graph API エクスプローラで me?fields=instagram_business_account{id,username} を実行する
IG_USER_ID=

# ---------------------------------------------------------------------------
# DB と Storage（必須）
# ---------------------------------------------------------------------------
# Postgres への接続文字列（Vault からトークンを読むので REST ではなく直結する）。
# ローカルは Supabase CLI の DB。コンテナからは host.docker.internal で届く。
# R2（Supabase Cloud）では接続プーラーのセッションモードの URL に差し替える。
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# Supabase の URL とサービスロールキー（サムネイルの Storage へのアップロードに使う）。
# ローカルの値は `supabase status` で確認する（service_role キー）。
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# スケジュールと収集の調整（省略時は既定値）
# ---------------------------------------------------------------------------
# hourly グループ（stories → media_sync → media_snapshot → account_backfill）を毎時何分に動かすか（0〜59）
WORKER_HOURLY_MINUTE=5

# daily グループ（token_check → profile_daily → account_daily → media_sync --full）を動かす日本時間の時刻（HH:MM）
WORKER_DAILY_TIME_JST=05:30

# account_backfill が 1 回の実行で進める日数（1〜730）
WORKER_BACKFILL_MAX_DAYS=30

# レート制限の使用率（%）がこれ以上ならすべてのジョブを止める（1〜100）
WORKER_RATE_HARD_LIMIT=90

# レート制限の使用率（%）がこれ以上なら account_backfill を進めない（1〜100）
WORKER_RATE_SOFT_LIMIT=50

# ログの詳細度（info か debug）。debug ではエラーメッセージの全文（マスク済み）も出る。
# GitHub Actions など公開されるログでは debug にしない。
WORKER_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# 結合テスト（.env には書かず、シェルで渡す）
# ---------------------------------------------------------------------------
# ホストからローカル Supabase の DB に接続する。設定されているときだけ結合テストが動く。例:
#   TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres npm run test -w worker
